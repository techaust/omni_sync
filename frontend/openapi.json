          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": ["admin", "operator", "viewer"],
            "title": "Role",
            "type": "string"
          },
          "username": {

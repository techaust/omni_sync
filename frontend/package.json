{
  "name": "omnisync-frontend",
  "private": true,
  "version": "2.0.0-dev.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "api:generate": "cd ../backend && uv run python scripts/export_openapi.py ../frontend/openapi.json && cd ../frontend && npx --yes -p openapi-typescript@7.13.0 -p typescript@5.9 openapi-typescript openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts openapi.json",
    "e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "api:check": "npm run api:generate && git diff --exit-code -- openapi.json src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "license": "GPL-3.0-only"
}
